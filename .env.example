# RazorShield AI — Razorpay credentials
#
# Copy this file to `.env` in the project root and fill in your keys:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit the secret, and never put it in frontend
# code — the browser only ever receives the key id, via GET /orders.
#
# TEST MODE ONLY. Test key ids start with `rzp_test_`. The app refuses to start
# with a `rzp_live_` key, because the difference is one character and the
# consequence is real money.
#
# Where to get these:
#   Key id + secret   Razorpay Dashboard → switch to Test Mode →
#                     Account & Settings → API Keys → Generate Test Key.
#                     The secret is shown once; save it now.
#   Webhook secret    Dashboard → Account & Settings → Webhooks → Add New
#                     Webhook. You choose this string yourself; paste the same
#                     value here and into the Dashboard field.
#
# After editing, restart the server and check GET /health — it reports
# `razorpay_configured`, `razorpay_test_mode` and which `env_file` it loaded.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local testing only: accept webhooks without a signature. Leave this unset.
# The webhook endpoint fails closed without it, which is the correct default.
# RAZORSHIELD_ALLOW_UNSIGNED=1
